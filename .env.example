# ══════════════════════════════════════════════════════════════════════════════
#  ShadeMusicBot — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Telegram API ─────────────────────────────────────────────────────────────
# Get API_ID and API_HASH from: https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff-1234567890

# ─── Bot Owner ────────────────────────────────────────────────────────────────
# Your Telegram numeric user ID (use @userinfobot to find it)
OWNER_ID=123456789

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Full connection string from MongoDB Atlas dashboard
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/

# Database name (will be created automatically on first use)
MONGO_DB_NAME=shademusicbot

# ─── Application Server ────────────────────────────────────────────────────────
# Host and port for the health check web server
# On Render, PORT is injected automatically — leave APP_PORT as 8080 fallback
APP_HOST=0.0.0.0
APP_PORT=8080

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Bot Behaviour ────────────────────────────────────────────────────────────
# Comma-separated list of extra admin user IDs (optional)
SUDO_USERS=

# Maximum songs allowed in a queue per chat
MAX_QUEUE_SIZE=50

# Default music volume (0-200)
DEFAULT_VOLUME=100

# ─── Phase 1: Voice Chat ──────────────────────────────────────────────────────
# Pyrogram string session for a USER account (the "assistant") that joins VCs.
# Generate with: python -c "from pyrogram import Client; Client('a').run()"
# then read the session string printed by Pyrogram.
# OPTIONAL — if absent, the bot client itself joins VCs (needs admin perms).
ASSISTANT_SESSION=

# Path to a Netscape-format cookies.txt exported from your browser.
# Used by yt-dlp to access age-restricted or region-locked videos.
# OPTIONAL — bot works for public videos without this file.
COOKIES_PATH=cookies.txt
